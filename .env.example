# Arc Launchpad — example environment configuration.
# Copy to .env and fill in. Do NOT commit your real .env (it is gitignored).

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Secret used to sign session JWTs. The app refuses to start in production
# without it. Generate one with: openssl rand -hex 32
LAUNCHPAD_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# RECOMMENDED (have sensible defaults, but you'll usually want to set these)
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of this Launchpad deployment. Used for links in emails and as
# the WebAuthn (passkey) origin. Default: http://localhost:5173
LAUNCHPAD_BASE_URL=http://localhost:5173

# adapter-node validates the Origin header on POST form submissions (SvelteKit
# CSRF); if it can't determine the correct origin, form actions fail with a 403
# ("Cross-site POST form submissions are forbidden"). The Docker image derives
# ORIGIN from LAUNCHPAD_BASE_URL automatically. If you run `node build` directly,
# set ORIGIN to the same public URL. Behind a reverse proxy that rewrites the
# scheme/host, set PROTOCOL_HEADER=x-forwarded-proto and HOST_HEADER=x-forwarded-host
# instead. See: https://svelte.dev/docs/kit/adapter-node#Environment-variables-ORIGIN
# ORIGIN=http://localhost:3000

# Path to the SQLite database file. Default: ./data/launchpad.db
# (The Docker image sets this to /app/data/launchpad.db.)
LAUNCHPAD_DB_PATH=./data/launchpad.db

# Display domain shown in the UI. Default: arc.localhost
LAUNCHPAD_DOMAIN=arc.localhost

# Allow Arc instance endpoints (and the proxy to them) to point at private /
# link-local / localhost addresses. OFF by default (SSRF-safe). Set to "true"
# only when your Arc server is intentionally on a private network reachable
# from this Launchpad host (common for self-hosted, same-cluster deployments).
# The proxy still resolves-and-pins the target IP regardless of this setting.
# LAUNCHPAD_ALLOW_PRIVATE_ENDPOINTS=false

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Email
# Email is normally configured in the UI (the first-run setup wizard, or
# Settings → Email) and stored in the database. These env vars are an
# alternative for operators who prefer config-as-env; the DB setting takes
# precedence if both are present. Without any email config, transactional
# emails (invites, verification, password reset) are printed to the server
# console instead of being sent.
#
# Mailgun:
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_API_URL=https://api.mailgun.net      # use https://api.eu.mailgun.net for EU
#
# SMTP (any provider):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false                            # true for port 465 (implicit TLS)
# SMTP_USER=
# SMTP_PASS=
#
# EMAIL_FROM=Arc Launchpad <noreply@example.com>

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Signup CAPTCHA (Cloudflare Turnstile)
# Without these, the signup CAPTCHA is skipped.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Ops alerting (Google Chat)
# Webhook to notify on silent server-side failures.
# ─────────────────────────────────────────────────────────────────────────────

# GCHAT_OPS_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — OAuth sign-in (Google)
# The login UI does not show OAuth buttons by default. The server callback
# route remains in the codebase; set these credentials (and re-enable the
# button) if you want Google sign-in.
# ─────────────────────────────────────────────────────────────────────────────

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
